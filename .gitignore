## segment_weights project

# local-only working notes, never tracked
CLAUDE.md

# editor configuration
.vscode/

# legacy reference scripts: env-specific, not pushed
refs/

# env-specific data (inputs from NFS/GCS, generated outputs).
# tests/data/ is anchored elsewhere and remains tracked.
/data/

# credentials and secrets
*-service-account*.json
*-credentials.json
service-account.json
.env.local

# generated tabular outputs anywhere, except tracked test fixtures and
# the committed Colombia example extract
*.csv
*.parquet
!tests/data/**/*.csv
!tests/data/**/*.parquet
!examples/colombia/data/**/*.parquet

# notebook execution artifacts
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# dask scratch
dask-worker-space/

