#!/bin/bash
# Scheduler template for the Monte Carlo pipeline. Copy, fill the
# placeholders, and submit yourself; nothing in this repo submits jobs.
#
# The template calls the real entry point and contains no business
# logic: everything the run does is declared in the pipeline TOML.
#SBATCH --job-name=segweights-montecarlo
#SBATCH --account=<account>
#SBATCH --partition=<partition>
#SBATCH --cpus-per-task=<n_cpus>
#SBATCH --mem=<memory>
#SBATCH --time=<walltime>
#SBATCH --output=segweights_montecarlo_%j.out

# Activate the environment that has segment_weights installed.
# <environment activation goes here>

set -euo pipefail

CONFIG=<path to pipeline TOML>

python -m segment_weights.pipelines.montecarlo "$CONFIG" --dry-run
python -m segment_weights.pipelines.montecarlo "$CONFIG"
